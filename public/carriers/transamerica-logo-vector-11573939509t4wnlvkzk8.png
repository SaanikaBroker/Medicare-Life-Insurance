<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 290 60" fill="none">
    <g transform="translate(10, 4)">
      <!-- Transamerica Pyramid -->
      <polygon points="16,0 20,50 12,50" fill="#D92525"/>
      <polygon points="16,0 12,50 6,50" fill="#B31B1B"/>
      <rect x="14" y="20" width="4" height="2" fill="#FFFFFF"/>
      <rect x="14" y="26" width="4" height="2" fill="#FFFFFF"/>
      <rect x="14" y="32" width="4" height="2" fill="#FFFFFF"/>
      <rect x="14" y="38" width="4" height="2" fill="#FFFFFF"/>
    </g>
    <text x="40" y="39" font-family="serif" font-size="24" font-weight="700" fill="#0B2545" letter-spacing="0.5">TRANSAMERICA<tspan font-size="12">®</tspan></text>
  </svg>